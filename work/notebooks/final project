        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "# إنشاء بيانات محاكاة (Synthetic Data) بنفس هيكل المشروع\n",
        "np.random.seed(42)\n",
        "n_rows = 500\n",
        "\n",
        "pages = [f\"/blog/article-{i}\" for i in range(1, 21)]\n",
        "queries = [f\"keyphrase search {i}\" for i in range(1, 51)]\n",
        "\n",
        "data = {\n",
        "    'page_path': np.random.choice(pages, n_rows),\n",
        "    'query': np.random.choice(queries, n_rows),\n",
        "    'impressions': np.random.randint(100, 5000, n_rows),\n",
        "    'clicks': np.random.randint(5, 300, n_rows),\n",
        "    'avg_position': np.random.uniform(1.0, 25.0, n_rows)\n",
        "}\n",
        "\n",
        "df = pd.DataFrame(data)\n",
        "\n",
        "# حساب CTR و Opportunity Score\n",
        "df['ctr'] = df['clicks'] / df['impressions']\n",
        "df['opportunity_score'] = df['impressions'] * (1 - df['ctr'])\n",
        "\n",
        "# عرض أعلى الصفحات أولوية للتعديل\n",
        "df_sorted = df.sort_values(by='opportunity_score', ascending=False)\n",
        "df_sorted.head(10)"
      ],
